[Unit]
Description=PlexMem API Service (Factorial 52!)
After=network.target

[Service]
Type=simple
User=plexmem
WorkingDirectory=/home/plexmem/plexmem
Environment="PATH=/home/plexmem/plexmem/venv/bin"
ExecStart=/home/plexmem/plexmem/venv/bin/python run_api.py
Restart=always
RestartSec=10
StandardOutput=append:/home/plexmem/plexmem/logs/api.log
StandardError=append:/home/plexmem/plexmem/logs/api.log

[Install]
WantedBy=multi-user.target

