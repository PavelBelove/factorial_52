[Unit]
Description=PlexMem Telegram Bot (Factorial 52!)
After=network.target plexmem-api.service

[Service]
Type=simple
User=plexmem
WorkingDirectory=/home/plexmem/plexmem
Environment="PATH=/home/plexmem/plexmem/venv/bin"
ExecStart=/home/plexmem/plexmem/venv/bin/python run_bot.py
Restart=always
RestartSec=10
StandardOutput=append:/home/plexmem/plexmem/logs/bot.log
StandardError=append:/home/plexmem/plexmem/logs/bot.log

[Install]
WantedBy=multi-user.target

